** Ramp Gen Comparison =====================================

* xrmp1 vrefp                         ramp1 vdda vss rst  ramp_generator_fixed c=20p r=12.7Meg
* xrmp2 irefp vss vdd vdd vdd vdd vdd ramp2 vdda vss rst  ramp_generator_idac  c=1p
* xrmp3 irefp vss vss vss vss vss vss ramp3 vdda vss rst  ramp_generator_idac  c=1p

xidac2 vc0 vc1 vc2 vc3 vc4 vc0i vc1i vc2i vc3i vc4i vx1 vx2 iref vdda vss idac

c1 vx1 vx1o 1p
c2 vx2 vx2o 1p
; r1 vx1 vx1o 1
; r2 vx2 vx2o 1

vx1 vx1o vss 0
vx2 vx2o vss 0


** Global IO ===============================================

* Power Rail

.param vdd=1.8
.param vss=0
Vddd vddd 0 {vdd}
Vdda vdda 0 {vdd}
Vss  vss  0 {vss}

* Clock and Reset (1MHz clock)

; Vrst    rst     0   pulse   {vss}   {vdd}   0u     0.1n  0.1n     2u    260u
; Vclk    clk     0   pulse   {vss}   {vdd}   1u     0.1n  0.1n   0.5u      1u
; Vclk2   clk2    0   pulse   {vss}   {vdd}   1.25u  0.1n  0.1n  0.25u    0.5u

vc0  vc0   vss  {vdd} ; pulse   {vss}   {vdd}   0u     0.1n  0.1n   4u        8u
vc1  vc1   vss  {vdd} ; pulse   {vss}   {vdd}   0u     0.1n  0.1n   8u        16u
vc2  vc2   vss  {vdd} ; pulse   {vss}   {vdd}   0u     0.1n  0.1n   16u       32u
vc3  vc3   vss  {vdd} ; pulse   {vss}   {vdd}   0u     0.1n  0.1n   32u       64u
vc4  vc4   vss  {vdd} ; pulse   {vss}   {vdd}   0u     0.1n  0.1n   64u       128u
vc0i vc0i  vss  {vss} ; pulse   {vdd}   {vss}   0u     0.1n  0.1n   4u        8u
vc1i vc1i  vss  {vss} ; pulse   {vdd}   {vss}   0u     0.1n  0.1n   8u        16u
vc2i vc2i  vss  {vss} ; pulse   {vdd}   {vss}   0u     0.1n  0.1n   16u       32u
vc3i vc3i  vss  {vss} ; pulse   {vdd}   {vss}   0u     0.1n  0.1n   32u       64u
vc4i vc4i  vss  {vss} ; pulse   {vdd}   {vss}   0u     0.1n  0.1n   64u       128u

* Reference Voltages

; vrfp  vss   vrefp 1
; vrfn  vrefn vss   1
iref iref vss 15u
* 1m -> 45m

** Control =================================================

.tran 50n 260u uic
.control 
    run 
    plot i(vx1) i(vx2) 

    alter vc1 {vss}
    alter vc2 {vss}
    alter vc3 {vss}
    alter vc4 {vss}
    alter vc1i {vdd}
    alter vc2i {vdd}
    alter vc3i {vdd}
    alter vc4i {vdd}

    run 
    plot i(vx1) i(vx2) 

.endc
.end
